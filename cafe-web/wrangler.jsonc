{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontop-gaming-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,

  // The website (HTML/CSS/JS) is served by Workers Static Assets. Only /api/* runs the Worker,
  // so the static files never see cookies, the database or secrets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ontop-gaming-db",
      // Replace with the id printed by `npx wrangler d1 create ontop-gaming-db` before deploying.
      // Local development (`--local`, `wrangler dev`) works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "observability": { "enabled": true }

  // SYNC_TOKEN is a secret: set it with `npx wrangler secret put SYNC_TOKEN` (production)
  // or in .dev.vars (local). Never put it in this file.
}
